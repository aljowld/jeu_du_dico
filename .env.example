# Configuration de l'environnement pour Le Jeu du Dico

# Clé secrète pour la signature des jetons JWT
# EN PRODUCTION : générer une clé aléatoire sécurisée d'au moins 32 caractères
# Exemple de génération : python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-insecure-jwt-secret-key-change-in-production

# URL de la base de données (optionnel, par défaut sqlite:///src/backend/words.db)
# DATABASE_URL=sqlite:///src/backend/words.db

